{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": ["eslint:recommended", "plugin:react/recommended"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "plugins": ["react"],
  "rules": {
    "complexity": ["error", 5],
    "no-console": "warn",
    "react/react-in-jsx-scope": "off",
    "react/prop-types": "off"
  },
  "settings": {
    "react": {
      "version": "detect"
    }
  },
  "globals": {
    "Phaser": "readonly",
    "ResponsiveUtils": "readonly",
    "AudioManager": "readonly",
    "Bubble": "readonly",
    "BackgroundComponent": "readonly",
    "ButtonComponent": "readonly",
    "DecorationsComponent": "readonly",
    "SliderComponent": "readonly",
    "TitleComponent": "readonly",
    "VisibilityHandlerMixin": "readonly",
    "ThemeConfig": "readonly"
  }
}
